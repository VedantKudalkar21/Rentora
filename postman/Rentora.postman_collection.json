    {
      "name": "6. Optional real Google sign-in",
      "description": "Skipped during a normal collection run. This requires configured GOOGLE_CLIENT_ID plus a fresh Google credential and its matching nonce from the frontend sign-in flow. Do not commit real credentials or exported tokens.",
      "item": [
        {
          "name": "Google sign-in with verified ID token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/auth/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{googleCredential}}\",\n  \"nonce\": \"{{googleNonce}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('googleCredential') || !pm.collectionVariables.get('googleNonce')) {",
                  "  console.log('Skipping optional Google request: obtain a fresh browser-issued Google credential and its matching nonce.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
