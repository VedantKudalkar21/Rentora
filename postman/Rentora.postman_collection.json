  "item": [
    {
      "name": "1. Accounts and JWT login",
      "item": [
        {
          "name": "Public auth configuration",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/auth/config"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register isolated test customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{runEmail}}\",\n  \"password\": \"{{runPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now().toString() + Math.floor(Math.random() * 100000).toString();",
                  "pm.collectionVariables.set('runEmail', 'rentora-postman-' + stamp + '@example.com');",
                  "pm.collectionVariables.set('runPassword', 'Postman@12345');",
                  "const local = new Date(Date.now() + 330 * 60000);",
                  "pm.collectionVariables.set('today', local.toISOString().slice(0, 10));",
                  "local.setUTCDate(local.getUTCDate() + 7); pm.collectionVariables.set('futureStart', local.toISOString().slice(0, 10));",
                  "local.setUTCDate(local.getUTCDate() + 2); pm.collectionVariables.set('futureEnd', local.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "pm.collectionVariables.set(\"customerToken\", data.accessToken);",
                  "pm.collectionVariables.set(\"customerId\", data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer password login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
